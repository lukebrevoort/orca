+        if row.height > viewport.height { shift = viewport.midY - row.midY }
+        else if row.minY < viewport.minY { shift = viewport.minY - row.minY }
+        else if row.maxY > viewport.maxY { shift = viewport.maxY - row.maxY }
+        else { return nil }
