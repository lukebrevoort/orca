+
+test("stage-one reproduction: oversized canonical metadata blocks metadata readiness", () => {
+  const f = fixture();
+  try {
+    f.insert("one", "x".repeat(33 * 1024) + " needle", "y".repeat(257 * 1024)); f.baseline();
+    let job; let count = 0;
+    while ((job = claimNextJob(f.canonical))) {
+      if (++count > 4) throw new Error("bounded reproduction exceeded four obligations");
+      acknowledgeReceipt(f.canonical, applyIndexJob(f.readonly, f.index, job, f.identity));
+    }
+    expect(f.jobs().map(j => [j.mode, j.state, j.error_code])).toEqual([["full", "blocked", "source_too_large"], ["metadata", "blocked", "source_too_large"]]);
+    expect(f.seal("metadata")).toBe(false); expect(f.seal("full")).toBe(false);
+    expect(verifySearchBuild(f.canonical, f.index).ready).toBe(false);
+  } finally { f.close(); }
+});
