{
  "name": "@orca/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/db/migrate.ts && bun src/index.ts",
    "dev": "bun run db:migrate && bun --env-file=../../.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:smoke": "bun test src/smoke.test.ts",
    "lint": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "db:verify": "bun --env-file=../../.env src/db/verify.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "@feedback-kit/core": "workspace:*",
    "@orca/shared": "workspace:*",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.2",
    "jose": "^6.1.2",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "drizzle-kit": "^0.31.10"
  }
}
