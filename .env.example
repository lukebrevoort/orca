# Current local API boot settings
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Current local persistence settings
# Resolved relative to `apps/api` because the API scripts run from that workspace.
DATABASE_PATH=./data/orca.sqlite

# Required once auth-backed flows are exercised
SESSION_SECRET=replace-with-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Gmail OAuth connect flow
GMAIL_CLIENT_ID=replace-me
GMAIL_CLIENT_SECRET=replace-me
GMAIL_REDIRECT_URI=http://localhost:3000/v1/auth/gmail/callback
GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email
# Optional overrides for UI routing after the callback completes
ORCA_GMAIL_OAUTH_SUCCESS_URL=http://localhost:5173/onboarding
ORCA_GMAIL_OAUTH_ERROR_URL=http://localhost:5173/login

# Outlook OAuth connect flow (Microsoft Entra)
OUTLOOK_CLIENT_ID=replace-me
OUTLOOK_CLIENT_SECRET=replace-me
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:3000/v1/auth/outlook/callback
OUTLOOK_OAUTH_SCOPES=openid profile email offline_access User.Read Mail.Read
ORCA_OUTLOOK_OAUTH_SUCCESS_URL=http://localhost:5173/onboarding
ORCA_OUTLOOK_OAUTH_ERROR_URL=http://localhost:5173/login

# Dev-only feedback delivery to the personal Linear workspace.
# Keep the API key in .env only; do not commit it.
LINEAR_API_KEY=replace-with-your-personal-linear-api-key
LINEAR_TEAM_ID=16291d5a-b027-48d5-b0c5-6a6e288dac0a
LINEAR_PROJECT_ID=8aaaf368-8ab6-43be-ba51-33560f289a39
LINEAR_FEEDBACK_LABEL_ID=73b02aaa-6ef9-4c46-9304-cd5f1753f4dd
LINEAR_FEEDBACK_STATE_ID=83b363c2-51a7-405f-9063-e3bbb03c2ff0
LINEAR_ASSIGNEE_ID=47ec32ea-723b-44fc-a275-02069b3c2805
