# Current local API boot settings
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Current local persistence settings
# Resolved relative to `apps/api` because the API scripts run from that workspace.
DATABASE_PATH=./data/orca.sqlite

# Required once auth-backed flows are exercised
SESSION_SECRET=replace-with-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Gmail OAuth connect flow
GMAIL_CLIENT_ID=replace-me
GMAIL_CLIENT_SECRET=replace-me
GMAIL_REDIRECT_URI=http://localhost:3000/v1/auth/gmail/callback
GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email
# Optional overrides for UI routing after the callback completes
ORCA_GMAIL_OAUTH_SUCCESS_URL=http://localhost:5173/settings/integrations/gmail
ORCA_GMAIL_OAUTH_ERROR_URL=http://localhost:5173/settings/integrations/gmail
